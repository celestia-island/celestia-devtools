root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml}]
indent_size = 4

[*.{js,ts,tsx,vue,json,yml,yaml,md,html,css,scss}]
indent_size = 2

# The Python conventions require four-space block indentation.
[*.py]
indent_size = 4

[Makefile]
indent_style = tab
